# Copiez ce fichier en .env et remplissez-le. Ne commitez JAMAIS le .env.

# Base de données (dans Docker, l'hôte est "db" ; en local, "localhost")
POSTGRES_USER=atelier
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=atelier
DATABASE_URL=postgresql+psycopg://atelier:changez-moi@localhost:5432/atelier

# JWT : générez une vraie clé, par ex. avec: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacez-par-une-cle-aleatoire-longue
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Premier administrateur créé par `python -m app.seed`
ADMIN_EMAIL=admin@atelier.sn
ADMIN_PASSWORD=changez-moi-aussi
ADMIN_NOM_COMPLET=Patron de l'atelier
